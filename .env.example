# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# Firebase web app config (safe to expose; security rules do the protecting).
# Production uses the real project, Preview uses the test project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Only needed once photos arrive.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Or skip the real project and use the local test servers (npm run emulators):
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Comma-separated emails allowed to use the AI routes (server only). Used from the AI step.
ALLOWED_EMAILS=

# Claude API (server only), from the AI step. Create at console.anthropic.com with a monthly spend limit.
ANTHROPIC_API_KEY=
