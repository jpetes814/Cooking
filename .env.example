# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# Firebase web app config (safe to expose; security rules do the protecting).
# Production uses the real project, Preview uses the test project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Only needed once photos arrive.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Or skip the real project and use the local test servers (npm run emulators):
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Comma-separated emails allowed to use the server routes like "Fill from link" (server only).
ALLOWED_EMAILS=

# Claude API (server only). Reads captions and plain pages for "Fill from link".
# Create at console.anthropic.com with a monthly spend limit. Recipe pages with
# standard markup still fill in without it.
ANTHROPIC_API_KEY=

# Optional (server only): lets "Fill from link" read YouTube descriptions, not just titles.
YOUTUBE_API_KEY=

# Tests only: fake recipe sites and stand-in AI answers instead of the network and Claude.
# AI_MOCK=1
